{
  "name": "lookbuddy-main",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:web": "pnpm --filter @lookbuddy/web dev",
    "build:web": "pnpm --filter @lookbuddy/web build",
    "test:web": "pnpm --filter @lookbuddy/web test",
    "dev:desktop": "pnpm build:web && pnpm --filter @lookbuddy/desktop start",
    "test:desktop": "pnpm --filter @lookbuddy/desktop test",
    "smoke:desktop": "pnpm build:web && pnpm --filter @lookbuddy/desktop smoke",
    "package:desktop": "pnpm build:web && pnpm --filter @lookbuddy/desktop package:win"
  }
}

