# Local development only. Copy to .env; never commit real keys or the .env file.
LOOKBUDDY_ENV=development
LOOKBUDDY_DATABASE_URL=sqlite:///./lookbuddy.db
LOOKBUDDY_JWT_SECRET=development-only-change-me-at-least-32-bytes
LOOKBUDDY_SCHEDULER_ENABLED=true
LOOKBUDDY_DEMO_LOGIN_ENABLED=false

# Local launcher defaults preserve the old LAN testing port.
HOST=0.0.0.0
PORT=5210

# Optional model for Buddy greetings. No key means fixed fallback messages.
LOOKBUDDY_GREETING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LOOKBUDDY_GREETING_MODEL=glm-4-flash
LOOKBUDDY_GREETING_API_KEY=

# Optional diary model; these settings are independent of greeting settings.
# LOOKBUDDY_ROUTER_BASE_URL=https://your-provider.example/v1
# LOOKBUDDY_ROUTER_MODEL=your-model
# LOOKBUDDY_ROUTER_API_KEY=

# Existing .env names remain supported by python app.py only:
# GLM_BASE_URL=...
# GLM_MODEL=...
# GLM_API_KEY=...
# If both are provided, the corresponding LOOKBUDDY_GREETING_* value wins.
