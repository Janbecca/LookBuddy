# ── LookBuddy 关心语后端环境变量 ──────────────────────
# 复制本文件为 .env，填入真实值。.env 不会被提交到版本库。
#
# GLM 标准接口（适用于自建应用，不使用 Coding Plan 专用额度）
# 获取 API Key: https://open.bigmodel.cn/ → 管理控制台 → API Keys

# GLM API Base URL（标准接口，一般不需要改）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型名称（按需选择，以下为常用选项）
# glm-4-flash     — 免费额度，速度快，适合气泡关心语
# glm-4           — 标准模型
# glm-4-plus      — 增强模型
GLM_MODEL=glm-4-flash

# API Key（从智谱开放平台获取，请勿提交到代码库）
GLM_API_KEY=

# 后端监听端口
PORT=5210
