{
  "$defs": {
    "EventSource": {
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "provider": {
          "default": "lookbuddy",
          "title": "Provider",
          "type": "string"
        },
        "sdk": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdk"
        },
        "sdkVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdkversion"
        },
        "rawType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rawtype"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EventSource",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "mediaRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mediaref"
        }
      },
      "required": [
        "method"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Privacy": {
      "properties": {
        "containsImage": {
          "default": false,
          "title": "Containsimage",
          "type": "boolean"
        },
        "retention": {
          "default": "event_only",
          "title": "Retention",
          "type": "string"
        }
      },
      "title": "Privacy",
      "type": "object"
    }
  },
  "properties": {
    "schema": {
      "const": "lookbuddy.event",
      "default": "lookbuddy.event",
      "title": "Schema",
      "type": "string"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "eventId": {
      "maxLength": 64,
      "minLength": 8,
      "title": "Eventid",
      "type": "string"
    },
    "type": {
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
      "title": "Type",
      "type": "string"
    },
    "deviceId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deviceid"
    },
    "sessionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sessionid"
    },
    "seq": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seq"
    },
    "occurredAt": {
      "format": "date-time",
      "title": "Occurredat",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/EventSource"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "durationMs": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Durationms"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Evidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "privacy": {
      "$ref": "#/$defs/Privacy"
    }
  },
  "required": [
    "eventId",
    "type",
    "occurredAt",
    "source"
  ],
  "title": "DomainEventIn",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lookbuddy:contract:v1:DomainEventIn"
}
