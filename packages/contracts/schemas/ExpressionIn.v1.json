        "webcam",
        "eufy_web_sdk",
        "simulated",
        "replay"
      ],
      "title": "Source",
      "type": "string"
    },
    "capturedAt": {
      "format": "date-time",
      "title": "Capturedat",
      "type": "string"
    },
    "cameraHealthy": {
      "default": true,
      "title": "Camerahealthy",
      "type": "boolean"
    },
    "quality": {
      "enum": [
        "observable",
        "insufficient",
        "unavailable"
      ],
      "title": "Quality",
      "type": "string"
    },
    "features": {
      "$ref": "#/$defs/ExpressionFeatures"
    }
  },
  "required": [
    "expressionId",
    "sessionId",
    "capturedAt",
    "quality",
    "features"
  ],
  "title": "ExpressionIn",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lookbuddy:contract:v1:ExpressionIn"
