LOOKBUDDY_ENV=development
LOOKBUDDY_DATABASE_URL=sqlite:///./lookbuddy.db
LOOKBUDDY_JWT_SECRET=change-me-before-sharing-use-at-least-32-bytes
LOOKBUDDY_ACCESS_TOKEN_MINUTES=30
LOOKBUDDY_REFRESH_TOKEN_DAYS=30

# Organizer Router: OpenAI-compatible. Leave blank to use deterministic templates.
LOOKBUDDY_ROUTER_BASE_URL=
LOOKBUDDY_ROUTER_API_KEY=
LOOKBUDDY_ROUTER_MODEL=

# Web origin used by the local Vite app.
LOOKBUDDY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Read by Vite config; useful when port 8000 is occupied.
LOOKBUDDY_BACKEND_URL=http://127.0.0.1:8000

